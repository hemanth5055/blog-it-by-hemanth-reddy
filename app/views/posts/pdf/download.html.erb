<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background-color: #ffffff;
    color: #111111;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .post-container {
    min-height: 100vh;
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 40px;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }

  .category-pill {
    border: 1px solid #ddd;
    color: #555;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 999px;
  }

  .post-title {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.2;
    color: #111111;
    margin-bottom: 28px;
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 48px;
  }

  .author-name {
    font-size: 14px;
    font-weight: 600;
    color: #111111;
  }

  .author-date {
    font-size: 12px;
    color: #999;
    margin-top: 2px;
  }

  .post-body {
    font-size: 18px;
    line-height: 1.9;
    color: #333;
    white-space: pre-line;
  }

  .post-footer {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid #ebebeb;
    font-size: 12px;
    color: #bbb;
  }
</style>

<div class="post-container">

  <div class="categories">
    <% @post.categories.each do |category| %>
      <span class="category-pill"><%= category.name %></span>
    <% end %>
  </div>

  <h1 class="post-title"><%= @post.title %></h1>
  <div class="author-row">
      <div class="author-name"><%= @post.user.name %></div>
      <div class="author-date"><%= @post.created_at.strftime("%B %-d, %Y") %></div>
  </div>

  <div class="post-body"><%= @post.description %></div>

</div>
